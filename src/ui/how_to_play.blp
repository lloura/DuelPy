using Gtk 4.0;
using Adw 1;

template $HowToPlayWindow : Adw.Window {
  title: _("Rules");
  default-width: 380;
  default-height: 550;
  modal: true;
  resizable: false;

  Gtk.ShortcutController {
    scope: managed;
    Gtk.Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }
  }

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      /* --- image section --- */
      Adw.PreferencesGroup {
        Gtk.Box {
          orientation: vertical;
          spacing: 12;
          margin-bottom: 12;

          Gtk.Image img_diagram {
            pixel-size: 300;

            styles [
              "icon-dropshadow",
            ]
          }
        }
      }

      /* --- dynamic rules section --- */
      Adw.PreferencesGroup rules_group {
        title: _("Move Interactions");
        description: _("Select a move to see which opponents it defeats and why.");
      }
    };
  }
}