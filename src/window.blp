using Gtk 4.0;
using Adw 1;

template $DuelpyWindow: Adw.ApplicationWindow {
  title: _("Duel!");
  default-width: 450;
  default-height: 600;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Gtk.MenuButton mode_selector {
        menu-model: window_menu;
        focus-on-click: false;
        always-show-arrow: true;
        can-shrink: true;
        tooltip-text: _("Mode Selection");

        child: Adw.ButtonContent mode_label {
          label: _("RPSLS");
          icon-name: "spock-symbolic";
        };
      }

      [end]
      Gtk.MenuButton {
        menu-model: primary_menu;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
      }
    }

    content: Adw.NavigationView navigation_view {
      /* ───────────── Home ───────────── */
      Adw.NavigationPage {
        title: _("Home");
        tag: "home";

        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;
          margin-start: 16;
          margin-end: 16;
          margin-bottom: 16;

          Gtk.Image {
            icon-name: "welcome";
            pixel-size: 160;
            margin-bottom: 16;

            styles [
              "icon-dropshadow",
            ]
          }

          Gtk.Label {
            label: _("Welcome!");
            halign: center;

            styles [
              "title-1",
            ]
          }

          /* ═══════════ ViewStack ═══════════ */
          Adw.ViewStack mode_stack {
            /* ─── RPSLS Mode ─── */
            Adw.ViewStackPage {
              name: "rpsls";
              title: _("RPSLS");

              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;

                Gtk.Label {
                  label: _("Let's Play Rock-Paper-Scissors-Lizard-Spock!");
                  halign: center;
                  wrap: true;
                  justify: center;
                  margin-bottom: 16;

                  styles [
                    "description",
                  ]
                }

                Adw.Clamp {
                  maximum-size: 250;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 8;

                    Gtk.Button {
                      action-name: "win.rock";

                      styles [
                        "opaque",
                        "button_rock",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Rock!");
                        icon-name: "rock-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.paper";

                      styles [
                        "opaque",
                        "button_paper",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Paper!");
                        icon-name: "paper-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.scissors";

                      styles [
                        "opaque",
                        "button_scissors",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Scissors!");
                        icon-name: "scissors-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.lizard";

                      styles [
                        "opaque",
                        "button_lizard",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Lizard!");
                        icon-name: "lizard-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.spock";

                      styles [
                        "opaque",
                        "button_spock",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Spock!");
                        icon-name: "spock-symbolic";
                      };
                    }
                  }
                }
              };
            }

            /* ─── Classic Mode -─── */
            Adw.ViewStackPage {
              name: "classic";
              title: _("Classic");

              child: Gtk.Box {
                orientation: vertical;
                spacing: 12;

                Gtk.Label {
                  label: _("Let's Play Rock-Paper-Scissors!");
                  halign: center;
                  wrap: true;
                  justify: center;
                  margin-bottom: 16;

                  styles [
                    "description",
                  ]
                }

                Adw.Clamp {
                  maximum-size: 250;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 8;

                    Gtk.Button {
                      action-name: "win.rock";

                      styles [
                        "opaque",
                        "button_rock",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Rock!");
                        icon-name: "rock-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.paper";

                      styles [
                        "opaque",
                        "button_paper",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Paper!");
                        icon-name: "paper-symbolic";
                      };
                    }

                    Gtk.Button {
                      action-name: "win.scissors";

                      styles [
                        "opaque",
                        "button_scissors",
                      ]

                      child: Adw.ButtonContent {
                        label: _("Scissors!");
                        icon-name: "scissors-symbolic";
                      };
                    }
                  }
                }
              };
            }
          }
        };
      }

      /* ───────────── Results ───────────── */
      Adw.NavigationPage {
        title: _("Results");
        tag: "results";

        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;
          margin-start: 16;
          margin-end: 16;
          margin-bottom: 16;

          Gtk.Box {
            orientation: horizontal;
            spacing: 16;
            margin-bottom: 16;

            Gtk.Image img_player_choice {
              pixel-size: 160;

              styles [
                "icon-dropshadow",
              ]
            }

            Gtk.Label {
              label: "VS";

              styles [
                "title-1",
              ]
            }

            Gtk.Image img_computer_choice {
              pixel-size: 160;

              styles [
                "icon-dropshadow",
              ]
            }
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-bottom: 32;

            Gtk.Label lbl_result {
              styles [
                "title-2",
              ]
            }

            Gtk.Label lbl_explanation {
              wrap: true;
              justify: center;

              styles [
                "description",
              ]
            }
          }

          Adw.Clamp {
            maximum-size: 250;

            Gtk.Button {
              action-name: "win.retry";

              styles [
                "opaque",
              ]

              child: Adw.ButtonContent {
                label: _("Try Again");
                icon-name: "view-refresh-symbolic";
              };
            }
          }
        };
      }
    };
  }
}

/* ───────────────── Menu ───────────────── */
menu primary_menu {
  section {
    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About Duel!");
      action: "app.about";
    }
  }
}

menu window_menu {
  section {
    item {
      label: _("RPSLS");
      action: "win.change-mode";
      target: "rpsls";
    }

    item {
      label: _("Classic");
      action: "win.change-mode";
      target: "classic";
    }
  }
}

/* ───────────────── Shortcuts ───────────────── */
Adw.ShortcutsDialog shortcuts_dialog {
  title: _("Keyboard Shortcuts");

  Adw.ShortcutsSection {
    title: _("Gameplay");

    Adw.ShortcutsItem {
      title: _("Rock");
      accelerator: "1";
      action-name: "win.rock";
    }

    Adw.ShortcutsItem {
      title: _("Paper");
      accelerator: "2";
      action-name: "win.paper";
    }

    Adw.ShortcutsItem {
      title: _("Scissors");
      accelerator: "3";
      action-name: "win.scissors";
    }

    Adw.ShortcutsItem {
      title: _("Lizard");
      accelerator: "4";
      action-name: "win.lizard";
    }

    Adw.ShortcutsItem {
      title: _("Spock");
      accelerator: "5";
      action-name: "win.spock";
    }

    Adw.ShortcutsItem {
      title: _("Retry");
      accelerator: "<Ctrl>R";
      action-name: "win.retry";
    }
  }

  Adw.ShortcutsSection {
    title: _("Mode");

    Adw.ShortcutsItem {
      title: _("RPSLS Mode");
      accelerator: "<Ctrl><Shift>R";
      action-name: "win.change-mode('rpsls')";
    }

    Adw.ShortcutsItem {
      title: _("Classic Mode");
      accelerator: "<Ctrl><Shift>C";
      action-name: "win.change-mode('classic')";
    }
  }
}
