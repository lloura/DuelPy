using Gtk 4.0;
using Adw 1;

template $DuelpyWindow: Adw.ApplicationWindow {
  title: _("Duel!");
  width-request: 360;
  height-request: 550;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Gtk.MenuButton mode_selector {
        menu-model: window_menu;
        focus-on-click: false;
        always-show-arrow: true;
        can-shrink: true;
        tooltip-text: _("Mode Selection");

        child: Adw.ButtonContent mode_label {
          label: _("RPSLS");
          icon-name: "spock-symbolic";
        };
      }

      [end]
      Gtk.MenuButton {
        menu-model: primary_menu;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
      }
    }

    content: Adw.NavigationView navigation_view {
      /* ───────────── Home ───────────── */
      Adw.NavigationPage {
        title: _("Home");
        tag: "home";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;

          child: Gtk.Box {
            orientation: vertical;
            valign: center;
            halign: center;
            spacing: 12;
            margin-top: 8;
            margin-bottom: 28;

            Gtk.Image img_welcome {
              icon-name: "welcome";
              pixel-size: 124;
              accessible-role: presentation;

              styles [
                "icon-dropshadow",
              ]
            }

            Gtk.Label {
              label: _("Welcome!");
              halign: center;

              styles [
                "title-1",
              ]
            }

            /* ═══════════ ViewStack ═══════════ */
            Adw.ViewStack mode_stack {
              Adw.ViewStackPage {
                name: "rpsls";
                title: _("RPSLS");

                child: $RpslsView {};
              }

              Adw.ViewStackPage {
                name: "classic";
                title: _("Classic");

                child: $ClassicView {};
              }

              Adw.ViewStackPage {
                name: "rps7";
                title: _("RPS-7");

                child: $Rps7View {};
              }
            }
          };
        };
      }

      /* ───────────── Results ───────────── */
      Adw.NavigationPage results_main_box {
        title: _("Results");
        tag: "results";

        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vscrollbar-policy: automatic;

          child: Gtk.Box {
            orientation: vertical;
            valign: center;
            halign: center;
            spacing: 8;
            margin-bottom: 28;

            Gtk.Box results_images_box {
              orientation: horizontal;
              margin-bottom: 12;
              spacing: 20;
              halign: center;

              Gtk.Image img_player_choice {
                pixel-size: 124;
                accessible-role: presentation;

                styles [
                  "icon-dropshadow",
                ]
              }

              Gtk.Label {
                label: "VS";
                accessible-role: label;

                styles [
                  "title-1",
                ]
              }

              Gtk.Image img_computer_choice {
                pixel-size: 124;
                accessible-role: presentation;

                styles [
                  "icon-dropshadow",
                ]
              }
            }

            Gtk.Box {
              orientation: vertical;
              spacing: 12;
              margin-bottom: 32;
              accessible-role: label;

              Gtk.Label lbl_result {
                styles [
                  "title-2",
                ]
              }

              Gtk.Label lbl_explanation {
                wrap: true;
                justify: center;
                accessible-role: label;

                styles [
                  "description",
                ]
              }
            }

            Adw.Clamp {
              maximum-size: 250;

              Gtk.Button {
                action-name: "win.retry";
                accessible-role: button;

                styles [
                  "opaque",
                ]

                child: Adw.ButtonContent {
                  label: _("Try Again");
                  icon-name: "view-refresh-symbolic";
                };
              }
            }
          };
        };
      }
    };
  }
}

/* ───────────────── Menu ───────────────── */
menu primary_menu {
  section {
    item {
      label: _("How to Play");
      action: "win.how-to-play";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About Duel!");
      action: "app.about";
    }
  }
}

menu window_menu {
  section {
    item {
      label: _("RPSLS");
      action: "win.change-mode";
      target: "rpsls";
    }

    item {
      label: _("Classic");
      action: "win.change-mode";
      target: "classic";
    }

    item {
      label: _("RPS-7");
      action: "win.change-mode";
      target: "rps7";
    }
  }
}
