#: data/io.github.lloura.DuelPy.gschema.xml:27
msgid ""
"The current game mode: 'rpsls' for Rock-Paper-Scissors-Lizard-Spock or "
"'classic' for Rock-Paper-Scissors"
msgstr ""
"O modo de jogo atual: 'rpsls' para Pedra-Papel-Tesoura-Lagarto-Spock ou "
"'classic' para 'Pedra-Papel-Tesoura'"

