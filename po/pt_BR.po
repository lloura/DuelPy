#: data/io.github.lloura.DuelPy.desktop.in:2
#: data/io.github.lloura.DuelPy.metainfo.xml.in:6 src/window.blp:5
msgid "Duel!"
msgstr "Duel!"

#: data/io.github.lloura.DuelPy.desktop.in:3
msgid "Play Rock, Paper, Scissors, Lizard, Spock!"
msgstr "Jogue Pedra, Papel, Tesoura, Lagarto, Spock!"

#: data/io.github.lloura.DuelPy.desktop.in:9
msgid "game;rock;paper;scissors;lizard;spock;rpsls;"
msgstr "jogo;pedra;papel;tesoura;lagarto;spock;pptls;"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:7
msgid "Epic hand-game duels"
msgstr "Duelos épicos de jogos de mãos"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:10
msgid ""
"Duel! is a modern take on hand-game classics. Challenge the computer in the "
"famous Rock, Paper, Scissors, Lizard, Spock variant or try the expanded "
"RPS-7 mode."
msgstr ""
"O Duel! é uma versão moderna de jogos de mãos clássicos. Desafie o "
"computador na famosa variante Pedra, Papel, Tesoura, Lagarto, Spock ou "
"experimente o modo expandido RPS-7."

#: data/io.github.lloura.DuelPy.metainfo.xml.in:13
msgid ""
"Enjoy a clean and intuitive experience designed to feel natural on your "
"desktop. Master all moves and see if you can outsmart the machine."
msgstr ""
"Desfrute de uma experiência limpa e intuitiva, projetada para parecer "
"natural na sua área de trabalho. Domine todas as jogadas e veja se consegue "
"superar a máquina."

#: data/io.github.lloura.DuelPy.metainfo.xml.in:16
msgid "Features:"
msgstr "Funcionalidades:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:18
msgid "Multiple game modes including Classic, RPSLS, and RPS-7"
msgstr "Múltiplos modos de jogo, incluindo Clássico, PPTLS e RPS-7"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:19
msgid "Visual guides for every game variant"
msgstr "Guias visuais para cada variante do jogo"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:20
msgid "Adaptive interface that works on any screen size"
msgstr "Interface adaptativa que funciona em qualquer tamanho de tela"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:21
msgid "Full keyboard support for fast-paced gameplay"
msgstr "Suporte total ao teclado para uma jogabilidade ágil"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:26
msgid "Lucas Loura"
msgstr "Lucas Loura"

