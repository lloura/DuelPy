#: data/io.github.lloura.DuelPy.desktop.in:2
#: data/io.github.lloura.DuelPy.metainfo.xml.in:6 src/window.blp:5
msgid "Duel!"
msgstr "Duel!"

#: data/io.github.lloura.DuelPy.desktop.in:3
msgid "Play Rock, Paper, Scissors, Lizard, Spock!"
msgstr "Jogue Pedra, Papel, Tesoura, Lagarto, Spock!"

#: data/io.github.lloura.DuelPy.desktop.in:9
msgid "game;rock;paper;scissors;lizard;spock;rpsls;"
msgstr "jogo;pedra;papel;tesoura;lagarto;spock;pptls;"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:7
msgid "Play Rock, Paper, Scissors, Lizard, Spock against the computer"
msgstr "Jogue Pedra, Papel, Tesoura, Lagarto, Spock contra o computador"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:10
msgid ""
"Duel! is a modern GNOME game implementing the Rock, Paper, Scissors, Lizard, "
"Spock variant popularized by The Big Bang Theory."
msgstr ""
"Duel! é um jogo moderno para GNOME que implementa a variante Pedra, Papel, "
"Tesoura, Lagarto, Spock popularizada pela série The Big Bang Theory."

#: data/io.github.lloura.DuelPy.metainfo.xml.in:13
msgid ""
"Built with GTK4 and Libadwaita, it provides a clean and intuitive interface "
"following GNOME's design guidelines. Challenge the computer and see if you "
"can master all five moves!"
msgstr ""
"Construído com GTK4 e Libadwaita, ele oferece uma interface limpa e "
"intuitiva seguindo as diretrizes de design do GNOME. Desafie o computador e "
"domine as cinco jogadas!"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:16
msgid "Features:"
msgstr "Funcionalidades:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:18
msgid "Classic RPSLS gameplay with all five moves"
msgstr "Jogabilidade clássica de PPTLS com todas as cinco jogadas"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:19
msgid "Modern adaptive interface"
msgstr "Interface moderna e adaptativa"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:20
msgid "Follows GNOME Human Interface Guidelines"
msgstr "Segue as diretrizes de interface humana (HIG) do GNOME"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:21
msgid "Clean and simple design"
msgstr "Design limpo e simples"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:26
msgid "Lucas Loura"
msgstr "Lucas Loura"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:46
msgid "Main welcome screen"
msgstr "Tela principal de boas-vindas"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:50
msgid "Game results showing Paper vs Spock"
msgstr "Resultados do jogo mostrando Papel vs Spock"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:54
msgid "Game results showing Lizard vs Rock"
msgstr "Resultados do jogo mostrando Lagarto vs Pedra"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:58
msgid "Game results showing Rock vs Scissors"
msgstr "Resultados do jogo mostrando Pedra vs Tesoura"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:62
msgid "Game results showing Paper vs Lizard"
msgstr "Resultados do jogo mostrando Papel vs Lagarto"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:66
msgid "\"How to Play\" screen for RPSLS"
msgstr "Tela \"Como Jogar\" para o PPTLS"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:70
msgid "Main RPS-7 screen"
msgstr "Tela principal do RPS-7"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:74
msgid "Game results showing Sponge vs Water"
msgstr "Resultados do jogo mostrando Esponja vs Água"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:78
msgid "Game results showing Fire vs Air"
msgstr "Resultados do jogo mostrando Fogo vs Ar"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:86
msgid "This release introduces the RPS-7 game mode and several improvements:"
msgstr "Essa versão introduz o modo de jogo RPS-7 e muitas melhorias:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:88
msgid ""
"Implemented new RPS-7 game mode (Rock-Paper-Scissors-Sponge-Fire-Water-Air)"
msgstr ""
"Implementação do novo modo de jogo RPS-7 Pedra-Papel-Tesoura-Esponja-Fogo-"
"Água-Ar!"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:89
msgid ""
"Added persistent window state, remembering size and maximized state between "
"sessions"
msgstr ""
"Adicionado estado de janela persistente, lembrando tamanho e estado "
"maximizado entre sessões"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:90
msgid ""
"Overhauled the localization system for better translation coverage across "
"all pages"
msgstr ""
"Reformulação do sistema de localização para uma melhor cobertura de tradução "
"em todas as páginas"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:91
msgid "Refreshed application and game icons"
msgstr "Atualização dos ícones de jogo e do aplicativo "

#: data/io.github.lloura.DuelPy.metainfo.xml.in:98
msgid "A major update focusing on user guidance and code quality:"
msgstr ""
"Uma grande atualização focada na orientação do usuário e na qualidade do "
"código:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:100
msgid ""
"Introduced a new \"How to Play\" section with visual guides for each game "
"mode"
msgstr ""
"Introduzida uma nova seção \"Como Jogar\" com guias visuais para cada modo "
"de jogo"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:101
msgid ""
"Significant internal restructuring and code refactoring for better "
"maintainability"
msgstr ""
"Reestruturação interna significativa e refatoração de código para melhor "
"manutenção"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:102
msgid "Added new keyboard shortcuts and updated the shortcuts window"
msgstr "Adicionados novos atalhos de teclado e janela de atalhos atualizada"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:109
msgid "Improved project information and attribution:"
msgstr "Melhoria na informação do projeto e atribuições:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:111
msgid "Redesigned the \"About\" window to provide a more modern experience"
msgstr ""
"Reformulação da janela \"Sobre\" para fornecer uma experiência mais moderna"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:112
msgid ""
"Added dedicated credits for game variant creators: Sam Kass, Karen Bryla and "
"David C. Lovelace"
msgstr ""
"Adicionados créditos aos criadores dos modos de jogo: Sam Kass, Karen Bryla "
"e David C. Lovelace"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:119
msgid "Expanded gameplay with new modes and persistence:"
msgstr "Jogabilidade expandida com novos modos e persistência:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:121
msgid "Added Classic game mode (Rock, Paper, Scissors)"
msgstr "Adicionado modo de jogo Clássico (Pedra, Papel, Tesoura)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:122
msgid "Implemented game mode persistence using GSettings"
msgstr "Implementada persistência de modo de jogo usando GSettings"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:123
msgid "New mode selector in the header bar"
msgstr "Novo seletor de modos na barra de título"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:130
msgid "Expanded accessibility with new languages and input methods:"
msgstr "Acessibilidade expandida com novos idiomas e métodos de entrada:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:132
msgid "Added support for internationalization (i18n) using gettext"
msgstr "Adicionado suporte para internacionalização (i18n) por meio do gettext"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:133
msgid "Added Brazilian Portuguese (pt_BR) translation"
msgstr "Adicionada tradução em Português Brasileiro (pt_BR)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:134
msgid "Keyboard shortcuts (1-5) are now triggerable via the keypad (Numpad)"
msgstr ""
"Atalhos de teclado (1-5) agora são acionáveis através do teclado numérico"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:141
msgid "Technical updates and improved shortcuts:"
msgstr "Atualizações técnicas e atalhos aprimorados:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:143
msgid "Added keyboard shortcuts for game actions and a shortcuts window"
msgstr "Adicionados novos atalhos para ações de jogo e uma janela de atalhos"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:144
msgid "Updated the Flatpak runtime to GNOME SDK 49"
msgstr "Atualizado runtime flatpak para o GNOME SDK 49"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:145
msgid "Slightly updated the application icon"
msgstr "Leve atualização do ícone do aplicativo"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:152
msgid "First public version of Duel! featuring:"
msgstr "Primeira versão pública do Duel! apresentando:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:154
msgid "Rock, Paper, Scissors, Lizard, Spock gameplay"
msgstr "Jogabilidade de Pedra, Papel, Tesoura, Lagarto, Spock"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:155
msgid "Modern GTK4/Libadwaita interface"
msgstr "Interface moderna usando GTK4/Libadwaita"

