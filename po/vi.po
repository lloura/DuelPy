#: data/io.github.lloura.DuelPy.desktop.in:2 src/window.blp:5
msgid "Duel!"
msgstr "Duel!"

#: data/io.github.lloura.DuelPy.desktop.in:3
msgid "Play Rock, Paper, Scissors, Lizard, Spock!"
msgstr "Chơi Rock, Paper, Scissors, Lizard, Spock!"

#: data/io.github.lloura.DuelPy.desktop.in:9
msgid "game;rock;paper;scissors;lizard;spock;rpsls;"
msgstr "game;rock;paper;scissors;lizard;spock;rpsls;"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:7
msgid "Epic hand-game duels"
msgstr "Trận đấu tay đôi hoành tráng"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:10
msgid "Duel! is a modern take on hand-game classics. Challenge the computer in the famous Rock, Paper, Scissors, Lizard, Spock variant or try the expanded RPS-7 mode."
msgstr "Duel! là một trò chơi cổ điển hiện đại trên tay. Thử thách máy tính trong biến thể Rock, Paper, Scissors, Lizard, Spock nổi tiếng hoặc thử chế độ RPS-7 mở rộng."

#: data/io.github.lloura.DuelPy.metainfo.xml.in:13
msgid "Enjoy a clean and intuitive experience designed to feel natural on your desktop. Master all moves and see if you can outsmart the machine."
msgstr ""
"Tận hưởng trải nghiệm rõ ràng và trực quan được thiết kế để mang lại cảm giác tự nhiên trên máy tính để bàn của bạn. Nắm vững mọi động tác và xem liệu bạn có thể vượt qua máy hay không."

#: data/io.github.lloura.DuelPy.metainfo.xml.in:16
msgid "Features:"
msgstr "Tính năng:"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:18
msgid "Multiple game modes including Classic, RPSLS, and RPS-7"
msgstr "Nhiều chế độ trò chơi bao gồm Cổ điển, RPSLS và RPS-7"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:19
msgid "Visual guides for every game variant"
msgstr "Hướng dẫn trực quan cho mọi biến thể trò chơi"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:20
msgid "Adaptive interface that works on any screen size"
msgstr "Giao diện thích ứng hoạt động trên mọi kích thước màn hình"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:21
msgid "Full keyboard support for fast-paced gameplay"
msgstr "Hỗ trợ bàn phím đầy đủ để chơi trò chơi có nhịp độ nhanh"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:30 src/window.blp:35 src/window.blp:89 src/window.blp:232 src/game_logic/modes.py:26
