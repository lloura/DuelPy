msgstr "Màn hình chào mừng chính"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:58
msgid "Game results showing Paper vs Spock"
msgstr "Kết quả trò chơi hiển thị Paper vs Spock"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:62
msgid "Visual guide for game rules"
msgstr "Hướng dẫn trực quan về luật chơi"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:66
msgid "Expanded RPS-7 game mode"
msgstr "Chế độ trò chơi RPS-7 mở rộng"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:70
msgid "Game results showing Fire vs Air"
msgstr "Kết quả trò chơi hiển thị Fire vs Air"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:77
msgid "Accessibility and Architecture Overhaul"
msgstr "Đại tu kiến ​​trúc và khả năng truy cập"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:79
msgid "Implemented accessible roles for all UI elements to support assistive technologies"
msgstr "Đã triển khai các vai trò có thể truy cập cho tất cả các thành phần giao diện người dùng để hỗ trợ các công nghệ hỗ trợ"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:80
msgid "Modularized the project structure by splitting widgets into separate files"
msgstr "Mô-đun hóa cấu trúc dự án bằng cách chia widgets thành các tệp riêng biệt"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:81
msgid "Enhanced adaptive layout with new breakpoints and scrollable window support"
msgstr "Bố cục thích ứng nâng cao với các điểm dừng mới và hỗ trợ cửa sổ có thể cuộn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:82
msgid "Updated \"About\" page design following GNOME 49 guidelines"
msgstr "Đã cập nhật thiết kế trang \"Giới thiệu\" theo hướng dẫn GNOME 49"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:88
msgid "Quality Improvements and Metadata Polish"
msgstr "Cải tiến chất lượng và đánh bóng siêu dữ liệu"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:90
msgid "Refined application description and summary for better clarity"
msgstr "Mô tả và tóm tắt ứng dụng được tinh chỉnh để rõ ràng hơn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:91
msgid "Updated screenshots to better showcase the interface"
msgstr "Đã cập nhật ảnh chụp màn hình để hiển thị giao diện tốt hơn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:92
msgid "Added metadata keywords to make the app easier to find"
msgstr "Đã thêm từ khóa siêu dữ liệu để giúp tìm ứng dụng dễ dàng hơn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:98
msgid "Introducing RPS-7"
msgstr "Giới thiệu RPS-7"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:100
msgid "Implemented new RPS-7 game mode (Rock-Paper-Scissors-Sponge-Fire-Water-Air)"
msgstr "Đã triển khai chế độ trò chơi RPS-7 mới (Rock-Paper-Scissors-Sponge-Fire-Water-Air)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:101
msgid "Added persistent window state, remembering size and maximized state between sessions"
msgstr "Đã thêm trạng thái cửa sổ liên tục, ghi nhớ kích thước và trạng thái tối đa giữa các phiên"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:102
msgid "Overhauled the localization system for better translation coverage across all pages"
msgstr "Đại tu hệ thống bản địa hóa để có phạm vi dịch tốt hơn trên tất cả các trang"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:103
msgid "Refreshed application and game icons"
msgstr "Các biểu tượng ứng dụng và trò chơi được làm mới"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:109
msgid "How to Play Guide and Refactoring"
msgstr "Hướng dẫn cách chơi và tái cấu trúc"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:111
msgid "Introduced a new \"How to Play\" section with visual guides for each game mode"
msgstr "Đã giới thiệu phần \"Cách chơi\" mới với hướng dẫn trực quan cho từng chế độ trò chơi"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:112
msgid "Significant internal restructuring and code refactoring for better maintainability"
msgstr "Tái cơ cấu nội bộ và tái cấu trúc mã đáng kể để có khả năng bảo trì tốt hơn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:113
msgid "Added new keyboard shortcuts and updated the shortcuts window"
msgstr "Đã thêm phím tắt mới và cập nhật cửa sổ phím tắt"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:119
msgid "Credits and Visual Polish"
msgstr "Ghi công và Hình ảnh Ba Lan"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:121
msgid "Redesigned the \"About\" window to provide a more modern experience"
msgstr "Thiết kế lại cửa sổ \"Giới thiệu\" để mang lại trải nghiệm hiện đại hơn"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:122
msgid "Added dedicated credits for game variant creators: Sam Kass, Karen Bryla and David C. Lovelace"
msgstr "Đã thêm tín dụng dành riêng cho người tạo biến thể trò chơi: Sam Kass, Karen Bryla và David C. Lovelace"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:128
msgid "Introducing Game Modes"
msgstr "Giới thiệu chế độ game"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:130
msgid "Added Classic game mode (Rock, Paper, Scissors)"
msgstr "Đã thêm chế độ trò chơi cổ điển (Rock, Paper, Scissors)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:131
msgid "Implemented game mode persistence using GSettings"
msgstr "Đã triển khai tính bền vững của chế độ trò chơi bằng GSSettings"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:132
msgid "New mode selector in the header bar"
msgstr "Bộ chọn chế độ mới trong thanh tiêu đề"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:138
msgid "Implemented Internationalization Support"
msgstr "Triển khai hỗ trợ quốc tế hóa"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:140
msgid "Added support for internationalization (i18n) using gettext"
msgstr "Đã thêm hỗ trợ quốc tế hóa (i18n) bằng gettext"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:141
msgid "Added Brazilian Portuguese (pt_BR) translation"
msgstr "Đã thêm bản dịch tiếng Bồ Đào Nha Brazil (pt_BR)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:142
msgid "Keyboard shortcuts (1-5) are now triggerable via the keypad (Numpad)"
msgstr "Các phím tắt (1-5) hiện có thể được kích hoạt thông qua bàn phím (Numpad)"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:148
msgid "Updated Runtime and Keybindings"
msgstr "Đã cập nhật thời gian chạy và liên kết phím"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:150
msgid "Added keyboard shortcuts for game actions and a shortcuts window"
msgstr "Đã thêm phím tắt cho các thao tác trong trò chơi và cửa sổ phím tắt"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:151
msgid "Updated the Flatpak runtime to GNOME SDK 49"
msgstr "Đã cập nhật thời gian chạy Flatpak lên GNOME SDK 49"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:152
msgid "Slightly updated the application icon"
msgstr "Cập nhật nhẹ biểu tượng ứng dụng"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:158
msgid "Initial release"
msgstr "Bản phát hành đầu tiên"

#: data/io.github.lloura.DuelPy.metainfo.xml.in:160
msgid "Rock, Paper, Scissors, Lizard, Spock gameplay"
