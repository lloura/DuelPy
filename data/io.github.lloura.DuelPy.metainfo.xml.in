  <releases>
    <release version="0.3.1" date="2025-12-29">
      <p>The RPS-7 Update</p>
      <description>
        <p>This release introduces the RPS-7 game mode and several improvements:</p>
        <ul>
          <li>Implemented new RPS-7 game mode (Rock-Paper-Scissors-Sponge-Fire-Water-Air)</li>
          <li>Added persistent window state, remembering size and maximized state between sessions</li>
          <li>Overhauled the localization system for better translation coverage across all pages</li>
          <li>Refreshed application and game icons</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2025-12-26">
      <p>How to Play Guide &amp; Refactoring</p>
      <description>
        <p>A major update focusing on user guidance and code quality:</p>
        <ul>
          <li>Introduced a new "How to Play" section with visual guides for each game mode</li>
          <li>Significant internal restructuring and code refactoring for better maintainability</li>
          <li>Added new keyboard shortcuts and updated the shortcuts window</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2025-12-21">
      <p>Credits and Visual Polish</p>
      <description>
        <p>Improved project information and attribution:</p>
        <ul>
          <li>Redesigned the "About" window to provide a more modern experience</li>
          <li>Added dedicated credits for game variant creators: Sam Kass, Karen Bryla and David C. Lovelace</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2025-12-20">
      <p>Introducing Game Modes</p>
      <description>
        <p>Expanded gameplay with new modes and persistence:</p>
        <ul>
          <li>Added Classic game mode (Rock, Paper, Scissors)</li>
          <li>Implemented game mode persistence using GSettings</li>
          <li>New mode selector in the header bar</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2025-12-19">
      <p>Implemented Internationalization Support</p>
      <description>
        <p>Expanded accessibility with new languages and input methods:</p>
        <ul>
          <li>Added support for internationalization (i18n) using gettext</li>
          <li>Added Brazilian Portuguese (pt_BR) translation</li>
          <li>Keyboard shortcuts (1-5) are now triggerable via the keypad (Numpad)</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2025-12-17">
      <p>Updated Runtime and Keybindings</p>
      <description>
        <p>Technical updates and improved shortcuts:</p>
        <ul>
          <li>Added keyboard shortcuts for game actions and a shortcuts window</li>
          <li>Updated the Flatpak runtime to GNOME SDK 49</li>
          <li>Slightly updated the application icon</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-12-17">
      <p>Initial release</p>
      <description>
        <p>First public version of Duel! featuring:</p>
        <ul>
          <li>Rock, Paper, Scissors, Lizard, Spock gameplay</li>
          <li>Modern GTK4/Libadwaita interface</li>
        </ul>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <categories>
    <category>Game</category>
  </categories>
</component>

