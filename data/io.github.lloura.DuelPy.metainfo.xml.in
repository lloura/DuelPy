<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.lloura.DuelPy</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Duel!</name>
  <summary>Play Rock, Paper, Scissors, Lizard, Spock against the computer</summary>

  <description>
    <p>
      Duel! is a modern GNOME game implementing the Rock, Paper, Scissors, Lizard, Spock variant popularized by The Big Bang Theory.
    </p>
    <p>
      Built with GTK4 and Libadwaita, it provides a clean and intuitive interface following GNOME's design guidelines. Challenge the computer and see if you can master all five moves!
    </p>
    <p>Features:</p>
    <ul>
      <li>Classic RPSLS gameplay with all five moves</li>
      <li>Modern adaptive interface</li>
      <li>Follows GNOME Human Interface Guidelines</li>
      <li>Clean and simple design</li>
    </ul>
  </description>

  <developer id="io.github.lloura">
    <name>Lucas Loura</name>
  </developer>

  <url type="homepage">https://github.com/lloura/DuelPy</url>
  <url type="vcs-browser">https://github.com/lloura/DuelPy</url>
  <url type="bugtracker">https://github.com/lloura/DuelPy/issues</url>

  <translation type="gettext">duelpy</translation>
  <launchable type="desktop-id">io.github.lloura.DuelPy.desktop</launchable>

  <!-- No violent or inappropriate content -->
  <content_rating type="oars-1.1"/>

  <!-- Brand colors - adjust to match your app's theme -->
  <branding>
    <color type="primary" scheme_preference="light">#8FF0A4</color>
    <color type="primary" scheme_preference="dark">#9141AC</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/main.png</image>
      <caption>Main welcome screen</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/paper_x_spock.png</image>
      <caption>Game results showing Paper vs Spock</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/lizard_x_rock.png</image>
      <caption>Game results showing Lizard vs Rock</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/rock_x_scissors.png</image>
      <caption>Game results showing Rock vs Scissors</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/paper_x_lizard.png</image>
      <caption>Game results showing Paper vs Lizard</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.1" date="2025-12-21">
      <p>Credits and Visual Polish</p>
      <description>
        <ul>
          <li>Redesigned the "About" window to provide a more modern experience and clearer project information</li>
          <li>Added dedicated credits for the game variant creators: Sam Kass and Karen Bryla (RPSLS) and David C. Lovelace (RPS-7)</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2025-12-20">
      <p>Introducing Game Modes</p>
      <description>
        <ul>
          <li>Added Classic game mode (Rock, Paper, Scissors)</li>
          <li>Implemented game mode persistence using GSettings</li>
          <li>New mode selector in the header bar</li>
          <li>Refactored internal architecture for better scalability</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2025-12-19">
      <p>Implemented Internationalization Support</p>
      <description>
        <ul>
          <li>Added support for internationalization (i18n) using gettext</li>
          <li>Added Brazilian Portuguese (pt_BR) translation</li>
          <li>Keyboard shortcuts (1-5) are now also triggerable via the keypad (Numpad)</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2025-12-17">
      <description>
        <p>Updated Runtime and Keybindings</p>
        <ul>
          <li>Added keyboard shortcuts for game actions (Rock, Paper, Scissors, Lizard, Spock, Retry)</li>
          <li>Added a 'Keyboard Shortcuts' window to easily see the available shortcuts</li>
          <li>Updated the Flatpak runtime to GNOME SDK 49</li>
          <li>Slightly updated the application icon</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-12-17">
      <description>
        <p>Initial release</p>
        <ul>
          <li>Rock, Paper, Scissors, Lizard, Spock gameplay</li>
          <li>Modern GTK4/Libadwaita interface</li>
          <li>Clean and simple design</li>
        </ul>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <categories>
    <category>Game</category>
  </categories>
</component>

