      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/lizard_x_rock.png</image>
      <caption>Game results showing Lizard vs Rock</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/rock_x_scissors.png</image>
      <caption>Game results showing Rock vs Scissors</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/lloura/DuelPy/main/data/screenshots/paper_x_lizard.png</image>
      <caption>Game results showing Paper vs Lizard</caption>
